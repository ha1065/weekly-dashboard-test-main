# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/weekly_reporting

# Clockify API Configuration
CLOCKIFY_API_KEY=your_clockify_api_key_here
CLOCKIFY_WORKSPACE_ID=your_workspace_id_here

# Optional: AWS Configuration (for QuickSight refresh automation)
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=123456789012

# Optional: Notification Configuration
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_TO=admin@yourdomain.com

# Optional: Application Configuration
# LOG_LEVEL=INFO
# IMPORT_BATCH_SIZE=1000
